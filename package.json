{
  "name": "mrrp",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "pnpm -r build",
    "deploy": "pnpm --filter @mrrp/worker run deploy",
    "dev:web": "pnpm --filter @mrrp/web dev",
    "dev:worker": "pnpm --filter @mrrp/worker dev",
    "e2e": "pnpm --filter @mrrp/web run e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "gates": "node scripts/check-gates.mjs",
    "size": "node scripts/check-size.mjs",
    "comments": "node scripts/check-comments.mjs",
    "docs": "node scripts/check-docs.mjs",
    "lint": "eslint . --ext .ts,.tsx",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "verify": "pnpm run verify:core && pnpm run e2e",
    "css-vars": "node scripts/check-css-vars.mjs",
    "css-classes": "node scripts/check-css-classes.mjs",
    "knip": "knip",
    "security:check": "pnpm audit --audit-level=low",
    "verify:core": "pnpm run security:check && pnpm run gates && pnpm run size && pnpm run comments && pnpm run css-vars && pnpm run css-classes && pnpm run docs && pnpm run knip && pnpm run typecheck && pnpm run lint && pnpm run format:check && pnpm run build && pnpm run test"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "eslint": "^8.57.1",
    "eslint-plugin-react-hooks": "^4.6.2",
    "knip": "^6.43.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3"
  }
}
