{
  "name": "mrrp",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint . --ext .ts,.tsx",
    "format:check": "prettier --check .",
    "gates": "node scripts/check-gates.mjs",
    "size": "node scripts/check-size.mjs",
    "dev:worker": "pnpm --filter @mrrp/worker dev",
    "dev:web": "pnpm --filter @mrrp/web dev",
    "deploy": "pnpm --filter @mrrp/worker run deploy",
    "test": "pnpm -r test",
    "e2e": "pnpm --filter @mrrp/web run e2e",
    "format": "prettier --write .",
    "verify": "pnpm run gates && pnpm run size && pnpm run typecheck && pnpm run lint && pnpm run format:check && pnpm run build && pnpm run test && pnpm run e2e"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^8.57.1",
    "eslint-plugin-react-hooks": "^4.6.2",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2"
  }
}
